{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/badkamer-renovatie",
      "destination": "/badkamerrenovatie",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/app"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app"
    }
  ]
}
